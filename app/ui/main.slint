import { ScrollView, LineEdit, ListView, CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { DialogButton, Icon, Menu, MenuEntry, SidebarTab, ToolButton } from "widgets.slint";
import { Assistant, AssistantPanel, ChatItem } from "assistant.slint";
import { SplitMark, SplitPage, SplitPane } from "split.slint";

export { Theme, Assistant, ChatItem, SplitMark, SplitPage }

export struct TabItem {
    title: string,
    tooltip: string,
}

// A page sheet, in document space (logical pixels from the scroll area's top-left).
export struct PageItem {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct TileItem {
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
}

// kind: 0 search hit, 1 current search hit, 2 selection, 3 picked comment, 4 handle,
// 5 focused field, 6 flashed page, 7 words Compare found changed, 8 the change shown now
export struct MarkItem {
    x: length,
    y: length,
    width: length,
    height: length,
    kind: int,
}

export struct ThumbItem {
    index: int,
    image: image,
    label: string,
    width: length,
    height: length,
    current: bool,
    selected: bool,
}

// One field of a tool's form: kind 0 text, 1 password, 2 check box, 3 choice.
export struct FormField {
    label: string,
    kind: int,
    text: string,
    checked: bool,
    options: [string],
    index: int,
}

export struct OutlineRow {
    title: string,
    depth: int,
    has-children: bool,
    expanded: bool,
    current: bool,
}

export struct PaletteItem {
    title: string,
    detail: string,
    shortcut: string,
}

export struct InfoRow {
    label: string,
    value: string,
}

export struct AttachmentRow {
    name: string,
    detail: string,
}

// state: 0 empty field, 1 valid, 2 valid but the signer's identity is unknown, 3 invalid.
export struct SignatureRow {
    name: string,
    status: string,
    detail: string,
    state: int,
}

export struct Swatch {
    name: string,
    color: color,
}

// A PDF name and what to call it: a stamp, a line end.
export struct Named {
    name: string,
    label: string,
}

export struct CommentRow {
    /// Index into the tab's comments, which the callbacks take.
    index: int,
    kind: string,
    text: string,
    detail: string,
    reply: bool,
    status: string,
}

export struct LayerRow {
    name: string,
    depth: int,
    toggle: bool,
    visible: bool,
    locked: bool,
}

export component MainWindow inherits Window {
    title: root.window-title;
    preferred-width: 1000px;
    preferred-height: 580px;
    min-width: 480px;
    min-height: 320px;
    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: 13px;

    // ---- State, set from Rust ----
    in property <string> window-title: "micropdf";
    in property <bool> has-document;
    in property <[TabItem]> tabs;
    in property <int> active-tab: -1;
    in property <[PageItem]> pages;
    in property <[TileItem]> tiles;
    in property <[MarkItem]> marks;
    in property <length> document-width;
    in property <length> document-height;
    in property <color> paper: #ffffff;
    in property <bool> chrome-visible: true;
    in property <bool> presenting;
    // 0 default, 1 text, 2 pointer
    in property <int> cursor;
    in property <int> page-count;
    in-out property <string> page-text;
    in property <string> zoom-text: "100%";
    // 0 fit width, 1 fit page, 2 custom
    in property <int> zoom-mode;
    // 0 single, 1 continuous, 2 two-up, 3 book
    in property <int> page-mode: 1;
    // 0 normal, 1 dark, 2 sepia, 3 invert
    in property <int> reading-mode;
    in property <bool> vim-enabled;
    in property <bool> can-back;
    in property <bool> can-forward;
    // Names of the steps Undo and Redo would take; empty when there is none.
    in property <string> undo-name;
    in property <string> redo-name;
    in property <bool> dirty;
    // 0 select, 1 note, 2 text box, 3 rectangle, 4 ellipse, 5 line, 6 drawing, 7 sign
    in property <int> tool;
    // What the Measure tool (13) measures: 0 distance, 1 perimeter, 2 area.
    in property <int> measure-kind;
    // The shape being drawn, as SVG path commands in document space; empty when none.
    in property <string> draft-path;
    in property <string> status-left;
    in property <string> status-right;

    in-out property <bool> sidebar-visible;
    // 0 pages, 1 outline, 2 info, 3 attachments, 4 layers, 5 comments
    in-out property <int> sidebar-tab;
    in property <[ThumbItem]> thumbs;
    in property <[OutlineRow]> outline;
    in property <[InfoRow]> info;
    in property <[AttachmentRow]> attachments;
    in property <[SignatureRow]> signatures;
    in property <[CommentRow]> comments;
    in property <[LayerRow]> layers;

    // The second pane, beside the document.
    in property <bool> split-open;
    in property <string> split-title;
    in property <bool> split-synced;
    in property <bool> split-comparing;
    in property <bool> split-overlay;
    in property <[SplitPage]> split-pages;
    in property <[SplitMark]> split-marks;
    in property <length> split-content-height;
    in-out property <length> split-viewport-y <=> split-pane.viewport-y;
    out property <length> split-view-width: split-pane.view-width;
    out property <length> split-view-height: split-pane.view-height;
    callback split-scrolled();

    in-out property <bool> find-visible;
    in-out property <string> find-query;
    in property <string> find-status;

    in-out property <bool> palette-visible;
    in property <string> palette-hint: "Type a command, a page number, or a file name";
    in property <bool> has-library;
    in property <[PaletteItem]> palette-items;
    in-out property <int> palette-selected;

    // "", "password", "confirm", "message"
    in property <string> dialog-kind;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <string> dialog-ok: "OK";
    in property <string> dialog-cancel-text: "Cancel";
    in-out property <string> dialog-input;

    in property <[PaletteItem]> recent-items;

    // Signature pad: "" when closed, else "signature" or "initials".
    in property <string> sign-kind;
    // 0 type, 1 draw, 2 image
    in-out property <int> sign-mode;
    in-out property <string> sign-text;
    in-out property <int> sign-font;
    in property <[string]> sign-fonts;
    // The drawn strokes as SVG path commands in pad space.
    in property <string> sign-path;
    in property <image> sign-image;
    in property <bool> has-signature;
    in property <bool> has-initials;

    // ---- Geometry, read from Rust ----
    in-out property <length> viewport-y <=> scroller.content-y;
    in-out property <length> viewport-x <=> scroller.content-x;
    out property <length> view-width: scroller.visible-width;
    out property <length> view-height: scroller.visible-height;
    in-out property <length> thumbs-y <=> thumbs-list.content-y;
    out property <length> thumbs-view-height: thumbs-list.visible-height;

    // ---- Events, handled in Rust ----
    callback view-changed();
    callback thumbs-scrolled();
    // text, control, shift, alt -> handled
    callback key-input(string, bool, bool, bool) -> bool;
    // x, y in document space; button: 0 left, 1 right, 2 middle; shift held
    callback pointer-down(length, length, int, bool);
    callback pointer-move(length, length);
    callback pointer-up(length, length);
    callback pointer-double(length, length);
    callback hover(length, length);
    // wheel delta, x, y
    callback wheel-zoom(length, length, length);
    callback command(string);
    callback select-tab(int);
    callback close-tab(int);
    callback thumb-clicked(int);
    // A page thumbnail pressed: with Ctrl or Shift held, or with the right button.
    callback thumb-press(int, bool, bool, bool);
    // A thumbnail released after the pointer moved this far down (up when negative).
    callback thumb-drop(int, length);
    in property <[FormField]> form-fields;
    callback form-edited(int, string);
    callback form-checked(int, bool);
    callback form-chosen(int, int);
    callback outline-clicked(int);
    callback outline-toggle(int);
    callback outline-menu(int);
    callback page-entered(string);
    callback find-edited(string);
    callback find-next();
    callback find-prev();
    callback palette-edited(string);
    callback palette-accept(int);
    callback dialog-accept(string);
    callback dialog-cancel();
    callback recent-clicked(int);
    callback attachment-save(int);
    callback signature-go(int);
    callback attachment-delete(int);
    callback layer-toggle(int);
    callback comment-clicked(int);
    callback comment-edit(int);
    callback comment-delete(int);
    callback comment-reply(int);
    callback comment-status(int, string);
    callback comment-filter-edited(string);
    in property <bool> has-comments;
    in-out property <string> comment-filter;
    // x, y in pad space
    callback sign-pad-down(length, length);
    callback sign-pad-move(length, length);

    public function focus-view() {
        view-focus.focus();
    }
    public function focus-find() {
        find-edit.focus();
        find-edit.select-all();
    }
    public function focus-page-field() {
        page-field.focus();
        page-field.select-all();
    }
    public function focus-palette() {
        palette-edit.text = "";
        palette-edit.focus();
    }
    public function focus-dialog() {
        dialog-edit.focus();
    }
    public function focus-dialog-author() {
        dialog-author-edit.focus();
    }
    public function focus-sign() {
        sign-focus.focus();
    }

    in property <[Named]> stamps;
    in property <[Named]> line-ends;

    // The style bar: the picked comment's look, or the colour of the active comment tool.
    in property <[Swatch]> swatches;
    in property <bool> style-visible;
    /// Index into swatches of the current colour, or -1.
    in property <int> style-color: -1;
    /// -1 when there is no fill to set, else 0 clear or 1 filled.
    in property <int> style-fill: -1;
    /// Line width in points; 0 when there is none to set.
    in property <float> style-width;
    /// Opacity in percent; -1 when it does not apply.
    in property <int> style-opacity: -1;
    callback style-color-picked(int);
    callback style-fill-toggled();
    callback style-width-picked(float);
    callback style-opacity-picked(int);
    /// The picked comment's border: 0 solid, 1 dashed, 2 cloudy; -1 when it has none.
    in property <int> style-border: -1;
    /// Whether the picked comment can be cloudy: rectangles and ellipses.
    in property <bool> style-cloudy;
    /// The picked line's start and end, as PDF names; empty for other kinds.
    in property <string> style-start;
    in property <string> style-end;
    /// The picked text box's text size in points; 0 when it has none.
    in property <float> style-font-size;
    /// Whether the style bar is for a picked comment, not a tool, so it has properties.
    in property <bool> style-picked;
    callback style-border-picked(int);
    callback style-end-picked(bool, string);
    callback style-font-size-picked(float);
    callback style-properties();
    property <bool> ends-start;

    // The properties dialog.
    in-out property <string> dialog-author;
    in-out property <string> dialog-subject;
    in-out property <bool> dialog-locked;
    in-out property <bool> dialog-printed;

    // The form field being filled in, in document space.
    in property <bool> field-editing;
    in property <length> field-x;
    in property <length> field-y;
    in property <length> field-width;
    in property <length> field-height;
    in property <length> field-font-size: 12px;
    in property <bool> field-multiline;
    in property <string> field-name;
    in-out property <string> field-text;
    /// The options of the focused list or combo box.
    in property <[string]> field-options;
    /// Ends typing: 1 moves to the next field, -1 to the previous one, 0 stays, 2 means the
    /// editor lost the keyboard.
    callback field-commit(int);
    callback field-cancel();
    callback field-choose(int);

    // The signature or stamp about to be placed, under the pointer, in document space.
    in property <bool> ghost-visible;
    in property <length> ghost-x;
    in property <length> ghost-y;
    in property <length> ghost-width;
    in property <length> ghost-height;
    in property <image> ghost-image;
    callback pointer-left();

    public function focus-assistant() {
        assistant-panel.focus-input();
    }

    public function show-stamp-menu() {
        stamp-menu.show();
    }

    public function focus-field-editor() {
        field-input.focus();
        field-input.select-all();
    }

    public function show-field-menu() {
        field-menu.show();
    }

    // Where the menu for selected text opens, in document space.
    in property <length> menu-x;
    in property <length> menu-y;

    public function show-text-menu() {
        text-menu.show();
    }

    changed viewport-y => { root.view-changed(); }
    changed viewport-x => { root.view-changed(); }
    changed view-width => { root.view-changed(); }
    changed view-height => { root.view-changed(); }
    changed thumbs-y => { root.thumbs-scrolled(); }
    changed thumbs-view-height => { root.thumbs-scrolled(); }

    init => {
        view-focus.focus();
    }

    view-focus := FocusScope {
        key-pressed(e) => {
            return root.key-input(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) ? accept : reject;
        }

        VerticalLayout {
            // ---- Tab strip ----
            Rectangle {
                height: root.chrome-visible && root.tabs.length > 0 ? Theme.tabstrip-height : 0px;
                visible: self.height > 0;
                background: Theme.bg-secondary;
                clip: true;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 4px;
                    spacing: 2px;
                    alignment: start;

                    for tab-item[i] in root.tabs: Rectangle {
                        width: min(240px, max(110px, tab-title.preferred-width + 48px));
                        border-top-left-radius: Theme.radius;
                        border-top-right-radius: Theme.radius;
                        background: i == root.active-tab ? Theme.bg : tab-touch.has-hover ? Theme.bg-hover : transparent;
                        accessible-role: tab;
                        accessible-label: tab-item.title;
                        accessible-item-selectable: true;
                        accessible-item-selected: i == root.active-tab;
                        accessible-action-default => { root.select-tab(i); }

                        tab-touch := TouchArea {
                            clicked => {
                                root.select-tab(i);
                            }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.up) {
                                    root.close-tab(i);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 4px;
                            spacing: 4px;
                            tab-title := Text {
                                text: tab-item.title;
                                overflow: elide;
                                vertical-alignment: center;
                                color: i == root.active-tab ? Theme.text : Theme.text-muted;
                            }
                            VerticalLayout {
                                alignment: center;
                                ToolButton {
                                    width: 24px;
                                    height: 24px;
                                    icon: "\u{E711}";
                                    tip: "Close " + tab-item.title;
                                    clicked => {
                                        root.close-tab(i);
                                    }
                                }
                            }
                        }
                        Rectangle {
                            y: 0;
                            height: 2px;
                            background: i == root.active-tab ? Theme.accent : transparent;
                        }
                    }
                }
            }

            // ---- Toolbar ----
            toolbar := Rectangle {
                height: root.chrome-visible ? Theme.toolbar-height : 0px;
                visible: self.height > 0;
                background: root.tabs.length > 0 ? Theme.bg : Theme.bg-secondary;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;

                    ToolButton {
                        icon: "\u{E700}";
                        tip: "Sidebar (F4)";
                        active: root.sidebar-visible;
                        clicked => {
                            root.command("sidebar");
                        }
                    }
                    ToolButton {
                        icon: "\u{E8E5}";
                        tip: "Open (Ctrl+O)";
                        clicked => {
                            root.command("open");
                        }
                    }
                    ToolButton {
                        icon: "\u{E74E}";
                        tip: "Save (Ctrl+S)";
                        enabled: root.dirty;
                        clicked => {
                            root.command("save");
                        }
                    }
                    ToolButton {
                        icon: "\u{E7A7}";
                        tip: root.undo-name != "" ? "Undo " + root.undo-name + " (Ctrl+Z)" : "Undo (Ctrl+Z)";
                        enabled: root.undo-name != "";
                        clicked => {
                            root.command("undo");
                        }
                    }
                    ToolButton {
                        icon: "\u{E7A6}";
                        tip: root.redo-name != "" ? "Redo " + root.redo-name + " (Ctrl+Y)" : "Redo (Ctrl+Y)";
                        enabled: root.redo-name != "";
                        clicked => {
                            root.command("redo");
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton {
                        icon: "\u{E72B}";
                        tip: "Back (Alt+Left)";
                        enabled: root.can-back;
                        clicked => {
                            root.command("back");
                        }
                    }
                    ToolButton {
                        icon: "\u{E72A}";
                        tip: "Forward (Alt+Right)";
                        enabled: root.can-forward;
                        clicked => {
                            root.command("forward");
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton {
                        icon: "\u{E70E}";
                        tip: "Previous page";
                        enabled: root.has-document;
                        clicked => {
                            root.command("prev-page");
                        }
                    }
                    page-field := LineEdit {
                        width: 58px;
                        text <=> root.page-text;
                        horizontal-alignment: center;
                        enabled: root.has-document;
                        accessible-label: "Page number";
                        accepted(t) => {
                            root.page-entered(t);
                            root.focus-view();
                        }
                    }
                    Text {
                        text: " / " + root.page-count;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    ToolButton {
                        icon: "\u{E70D}";
                        tip: "Next page";
                        enabled: root.has-document;
                        clicked => {
                            root.command("next-page");
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton {
                        icon: "\u{E71F}";
                        tip: "Zoom out (Ctrl+-)";
                        enabled: root.has-document;
                        clicked => {
                            root.command("zoom-out");
                        }
                    }
                    zoom-button := ToolButton {
                        label: root.zoom-text;
                        tip: "Zoom";
                        enabled: root.has-document;
                        clicked => {
                            zoom-menu.show();
                        }
                    }
                    ToolButton {
                        icon: "\u{E8A3}";
                        tip: "Zoom in (Ctrl+=)";
                        enabled: root.has-document;
                        clicked => {
                            root.command("zoom-in");
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton {
                        icon: "\u{E7AD}";
                        tip: "Rotate view clockwise (Ctrl+Shift+=)";
                        enabled: root.has-document;
                        clicked => {
                            root.command("rotate-cw");
                        }
                    }
                    layout-button := ToolButton {
                        label: root.page-mode == 0 ? "Single" : root.page-mode == 2 ? "Two-up" : root.page-mode == 3 ? "Book" : "Continuous";
                        tip: "Page layout";
                        enabled: root.has-document;
                        clicked => {
                            layout-menu.show();
                        }
                    }
                    view-button := ToolButton {
                        icon: "\u{E7B3}";
                        tip: "Reading mode";
                        active: root.reading-mode != 0;
                        clicked => {
                            view-menu.show();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    tool-button := ToolButton {
                        icon: "\u{E70F}";
                        tip: "Comment tools";
                        active: root.tool != 0;
                        enabled: root.has-document;
                        clicked => {
                            tool-menu.show();
                        }
                    }
                    ToolButton {
                        icon: "\u{E7E6}";
                        tip: "Highlight selected text";
                        enabled: root.has-document;
                        clicked => {
                            root.command("highlight");
                        }
                    }
                    ToolButton {
                        icon: "\u{E8DC}";
                        tip: "Underline selected text";
                        enabled: root.has-document;
                        clicked => {
                            root.command("underline");
                        }
                    }
                    ToolButton {
                        icon: "\u{EDE0}";
                        tip: "Strike out selected text";
                        enabled: root.has-document;
                        clicked => {
                            root.command("strikeout");
                        }
                    }
                    tools-button := ToolButton {
                        label: "Tools";
                        tip: "Pages, stamps, protection and redaction";
                        enabled: root.has-document;
                        clicked => {
                            tools-menu.show();
                        }
                    }
                    convert-button := ToolButton {
                        label: "Convert";
                        tip: "Export to other formats, or make a PDF of other files";
                        clicked => {
                            convert-menu.show();
                        }
                    }
                    sign-button := ToolButton {
                        label: "Sign";
                        tip: "Sign or add initials";
                        active: root.tool == 7;
                        enabled: root.has-document;
                        clicked => {
                            sign-menu.show();
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton {
                        icon: "\u{E721}";
                        tip: "Find (Ctrl+F)";
                        active: root.find-visible;
                        enabled: root.has-document;
                        clicked => {
                            root.command("find");
                        }
                    }
                    ToolButton {
                        icon: "\u{E8BD}";
                        tip: "Assistant (Ctrl+Shift+A)";
                        active: Assistant.open;
                        clicked => {
                            root.command("assistant");
                        }
                    }
                    ToolButton {
                        icon: "\u{E712}";
                        tip: "All commands (Ctrl+K)";
                        clicked => {
                            root.command("palette");
                        }
                    }
                }

                zoom-menu := PopupWindow {
                    x: zoom-button.x;
                    y: parent.height - 4px;
                    width: 170px;
                    Menu {
                        MenuEntry { text: "Fit width"; checked: root.zoom-mode == 0; clicked => { root.command("fit-width"); } }
                        MenuEntry { text: "Fit page"; checked: root.zoom-mode == 1; clicked => { root.command("fit-page"); } }
                        MenuEntry { text: "Actual size"; clicked => { root.command("zoom-100"); } }
                        for z in [50, 75, 125, 150, 200, 300, 400]: MenuEntry {
                            text: z + "%";
                            clicked => {
                                root.command("zoom-" + z);
                            }
                        }
                    }
                }
                layout-menu := PopupWindow {
                    x: layout-button.x;
                    y: parent.height - 4px;
                    width: 180px;
                    Menu {
                        MenuEntry { text: "Single page"; checked: root.page-mode == 0; clicked => { root.command("mode-single"); } }
                        MenuEntry { text: "Continuous"; checked: root.page-mode == 1; clicked => { root.command("mode-continuous"); } }
                        MenuEntry { text: "Two-up"; checked: root.page-mode == 2; clicked => { root.command("mode-two-up"); } }
                        MenuEntry { text: "Book (cover alone)"; checked: root.page-mode == 3; clicked => { root.command("mode-book"); } }
                    }
                }
                tool-menu := PopupWindow {
                    x: tool-button.x;
                    y: parent.height - 4px;
                    width: 180px;
                    Menu {
                        MenuEntry { text: "Select text"; checked: root.tool == 0; clicked => { root.command("tool-select"); } }
                        MenuEntry { text: "Note"; checked: root.tool == 1; clicked => { root.command("tool-note"); } }
                        MenuEntry { text: "Text box"; checked: root.tool == 2; clicked => { root.command("tool-text"); } }
                        MenuEntry { text: "Rectangle"; checked: root.tool == 3; clicked => { root.command("tool-rect"); } }
                        MenuEntry { text: "Ellipse"; checked: root.tool == 4; clicked => { root.command("tool-ellipse"); } }
                        MenuEntry { text: "Line"; checked: root.tool == 5; clicked => { root.command("tool-line"); } }
                        MenuEntry { text: "Draw"; checked: root.tool == 6; clicked => { root.command("tool-ink"); } }
                        MenuEntry { text: "Callout"; checked: root.tool == 9; clicked => { root.command("tool-callout"); } }
                        MenuEntry { text: "Stamp\u{2026}"; checked: root.tool == 8; clicked => { stamp-menu.show(); } }
                        MenuEntry { text: "Attach file"; checked: root.tool == 10; clicked => { root.command("tool-attach"); } }
                    }
                }

                tools-menu := PopupWindow {
                    x: min(tools-button.x, parent.width - 660px);
                    y: parent.height - 4px;
                    width: 660px;
                    HorizontalLayout {
                        spacing: 4px;
                        Menu {
                            MenuEntry { text: "Edit text"; checked: root.tool == 14; clicked => { root.command("tool-edit-text"); } }
                            MenuEntry { text: "Add text"; checked: root.tool == 15; clicked => { root.command("tool-add-text"); } }
                            MenuEntry { text: "Edit images"; checked: root.tool == 16; clicked => { root.command("tool-edit-image"); } }
                            MenuEntry { text: "Add an image\u{2026}"; clicked => { root.command("image-add"); } }
                            MenuEntry { text: "Links"; checked: root.tool == 17; clicked => { root.command("tool-link"); } }
                            MenuEntry { text: "Add a bookmark\u{2026}"; clicked => { root.command("bookmark-add"); } }
                            MenuEntry { text: "Rotate pages\u{2026}"; clicked => { root.command("pages-rotate"); } }
                            MenuEntry { text: "Delete pages\u{2026}"; clicked => { root.command("pages-delete-some"); } }
                            MenuEntry { text: "Extract pages\u{2026}"; clicked => { root.command("pages-extract"); } }
                            MenuEntry { text: "Split document\u{2026}"; clicked => { root.command("split"); } }
                            MenuEntry { text: "Combine files\u{2026}"; clicked => { root.command("combine"); } }
                            MenuEntry { text: "Crop pages\u{2026}"; clicked => { root.command("pages-crop"); } }
                            MenuEntry { text: "Number pages\u{2026}"; clicked => { root.command("page-labels"); } }
                            MenuEntry { text: "Header and footer\u{2026}"; clicked => { root.command("header-footer"); } }
                            MenuEntry { text: "Watermark\u{2026}"; clicked => { root.command("watermark"); } }
                            MenuEntry { text: "Bates numbering\u{2026}"; clicked => { root.command("bates"); } }
                        }
                        Menu {
                            MenuEntry { text: "Protect with password\u{2026}"; clicked => { root.command("protect"); } }
                            MenuEntry { text: "Remove protection"; clicked => { root.command("unprotect"); } }
                            MenuEntry { text: "Reduce file size\u{2026}"; clicked => { root.command("optimize"); } }
                            MenuEntry { text: "Document properties\u{2026}"; clicked => { root.command("doc-properties"); } }
                            MenuEntry { text: "Sanitize\u{2026}"; clicked => { root.command("sanitize"); } }
                            MenuEntry { text: "Redact area"; checked: root.tool == 11; clicked => { root.command("tool-redact"); } }
                            MenuEntry { text: "Redact selected text"; clicked => { root.command("redact-selection"); } }
                            MenuEntry { text: "Search and redact\u{2026}"; clicked => { root.command("redact-search"); } }
                            MenuEntry { text: "Apply redactions\u{2026}"; clicked => { root.command("redact-apply"); } }
                            MenuEntry { text: "Measure distance"; checked: root.tool == 13 && root.measure-kind == 0; clicked => { root.command("measure-distance"); } }
                            MenuEntry { text: "Measure perimeter"; checked: root.tool == 13 && root.measure-kind == 1; clicked => { root.command("measure-perimeter"); } }
                            MenuEntry { text: "Measure area"; checked: root.tool == 13 && root.measure-kind == 2; clicked => { root.command("measure-area"); } }
                            MenuEntry { text: "Set the measuring scale\u{2026}"; clicked => { root.command("measure-scale"); } }
                            MenuEntry { text: "Recognize text (OCR)\u{2026}"; clicked => { root.command("ocr"); } }
                            MenuEntry { text: "Compare with a file\u{2026}"; clicked => { root.command("compare"); } }
                        }
                        Menu {
                            MenuEntry { text: "Prepare form"; checked: root.tool == 18; clicked => { root.command("tool-prepare"); } }
                            MenuEntry { text: "Add a text field"; clicked => { root.command("field-text"); } }
                            MenuEntry { text: "Add a checkbox"; clicked => { root.command("field-checkbox"); } }
                            MenuEntry { text: "Add radio buttons"; clicked => { root.command("field-radio"); } }
                            MenuEntry { text: "Add a dropdown"; clicked => { root.command("field-dropdown"); } }
                            MenuEntry { text: "Add a list box"; clicked => { root.command("field-list"); } }
                            MenuEntry { text: "Add a button"; clicked => { root.command("field-button"); } }
                            MenuEntry { text: "Add a signature field"; clicked => { root.command("field-signature"); } }
                            MenuEntry { text: "Field properties\u{2026}"; clicked => { root.command("field-properties"); } }
                            MenuEntry { text: "Find where fields go"; clicked => { root.command("field-detect"); } }
                            MenuEntry { text: "Tab order by rows"; clicked => { root.command("field-order-rows"); } }
                            MenuEntry { text: "Tab order by columns"; clicked => { root.command("field-order-columns"); } }
                            MenuEntry { text: "Run a tool on many files\u{2026}"; clicked => { root.command("batch"); } }
                        }
                    }
                }

                convert-menu := PopupWindow {
                    x: min(convert-button.x, parent.width - 240px);
                    y: parent.height - 4px;
                    width: 240px;
                    Menu {
                        if root.has-document: MenuEntry { text: "Export to Word\u{2026}"; clicked => { root.command("export-word"); } }
                        if root.has-document: MenuEntry { text: "Export to Excel\u{2026}"; clicked => { root.command("export-excel"); } }
                        if root.has-document: MenuEntry { text: "Export to PowerPoint\u{2026}"; clicked => { root.command("export-powerpoint"); } }
                        if root.has-document: MenuEntry { text: "Export to OpenDocument\u{2026}"; clicked => { root.command("export-odt"); } }
                        if root.has-document: MenuEntry { text: "Export as PNG images\u{2026}"; clicked => { root.command("export-png"); } }
                        if root.has-document: MenuEntry { text: "Export as JPEG images\u{2026}"; clicked => { root.command("export-jpeg"); } }
                        if root.has-document: MenuEntry { text: "Export to plain text\u{2026}"; clicked => { root.command("export-text"); } }
                        if root.has-document: MenuEntry { text: "Export to a web page\u{2026}"; clicked => { root.command("export-html"); } }
                        if root.has-document: MenuEntry { text: "Export to Markdown\u{2026}"; clicked => { root.command("export-markdown"); } }
                        MenuEntry { text: "Create a PDF from files\u{2026}"; clicked => { root.command("create-pdf"); } }
                        MenuEntry { text: "LibreOffice add-on\u{2026}"; clicked => { root.command("addon"); } }
                    }
                }

                stamp-menu := PopupWindow {
                    x: tool-button.x;
                    y: parent.height - 4px;
                    width: 200px;
                    Menu {
                        for stamp in root.stamps: MenuEntry {
                            text: stamp.label;
                            clicked => { root.command("stamp-" + stamp.name); }
                        }
                    }
                }

                sign-menu := PopupWindow {
                    x: sign-button.x;
                    y: parent.height - 4px;
                    width: 230px;
                    Menu {
                        MenuEntry {
                            text: root.has-signature ? "Add signature" : "Create signature";
                            clicked => { root.command("sign"); }
                        }
                        MenuEntry {
                            text: root.has-initials ? "Add initials" : "Create initials";
                            clicked => { root.command("initials"); }
                        }
                        if root.has-signature: MenuEntry {
                            text: "New signature";
                            clicked => { root.command("new-signature"); }
                        }
                        if root.has-initials: MenuEntry {
                            text: "New initials";
                            clicked => { root.command("new-initials"); }
                        }
                        if root.has-signature || root.has-initials: MenuEntry {
                            text: "Forget saved signatures";
                            clicked => { root.command("forget-signatures"); }
                        }
                        MenuEntry {
                            text: "Sign with a certificate";
                            checked: root.tool == 12;
                            clicked => { root.command("tool-certify"); }
                        }
                    }
                }

                view-menu := PopupWindow {
                    x: view-button.x;
                    y: parent.height - 4px;
                    width: 240px;
                    Menu {
                        MenuEntry { text: "Normal pages"; checked: root.reading-mode == 0; clicked => { root.command("read-normal"); } }
                        MenuEntry { text: "Dark pages"; checked: root.reading-mode == 1; clicked => { root.command("read-dark"); } }
                        MenuEntry { text: "Sepia pages"; checked: root.reading-mode == 2; clicked => { root.command("read-sepia"); } }
                        MenuEntry { text: "Inverted pages"; checked: root.reading-mode == 3; clicked => { root.command("read-invert"); } }
                        MenuEntry { text: "Vim keys"; checked: root.vim-enabled; clicked => { root.command("toggle-vim"); } }
                        MenuEntry { text: "Light or dark theme"; clicked => { root.command("toggle-theme"); } }
                        MenuEntry { text: "Show this document twice"; clicked => { root.command("split-same"); } }
                        MenuEntry { text: "Show a file beside it\u{2026}"; clicked => { root.command("split-file"); } }
                        MenuEntry { text: "Compare with a file\u{2026}"; clicked => { root.command("compare"); } }
                        if root.split-open: MenuEntry { text: "Close the second pane"; clicked => { root.command("split-close"); } }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border-muted;
                }
            }

            // ---- Body ----
            HorizontalLayout {
                vertical-stretch: 1;

                // Sidebar
                Rectangle {
                    width: root.sidebar-visible && root.chrome-visible && root.has-document ? Theme.sidebar-width : 0px;
                    visible: self.width > 0;
                    background: Theme.bg-secondary;
                    clip: true;

                    VerticalLayout {
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 4px;
                            SidebarTab { text: "Pages"; active: root.sidebar-tab == 0; clicked => { root.sidebar-tab = 0; root.thumbs-scrolled(); } }
                            SidebarTab { text: "Outline"; active: root.sidebar-tab == 1; clicked => { root.sidebar-tab = 1; } }
                            if root.has-comments: SidebarTab { text: "Comments"; active: root.sidebar-tab == 5; clicked => { root.sidebar-tab = 5; } }
                            if root.layers.length > 0: SidebarTab { text: "Layers"; active: root.sidebar-tab == 4; clicked => { root.sidebar-tab = 4; } }
                            if root.attachments.length > 0: SidebarTab { text: "Files"; active: root.sidebar-tab == 3; clicked => { root.sidebar-tab = 3; } }
                            if root.signatures.length > 0: SidebarTab { text: "Signed"; active: root.sidebar-tab == 6; clicked => { root.sidebar-tab = 6; } }
                            SidebarTab { text: "Info"; active: root.sidebar-tab == 2; clicked => { root.sidebar-tab = 2; } }
                        }
                        Rectangle {
                            vertical-stretch: 1;

                            thumbs-list := ListView {
                                visible: root.sidebar-tab == 0;
                                for thumb in root.thumbs: Rectangle {
                                    height: thumb.height + 34px;
                                    accessible-role: button;
                                    accessible-label: "Page " + thumb.label;
                                    accessible-action-default => {
                                        root.thumb-press(thumb.index, false, false, false);
                                        root.thumb-drop(thumb.index, 0);
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: 8px;
                                        width: thumb.width + 6px;
                                        height: thumb.height + 6px;
                                        border-radius: Theme.radius-sm;
                                        background: thumb.current ? Theme.accent : thumb.selected ? Theme.accent.with-alpha(0.45) : transparent;
                                        Rectangle {
                                            x: 3px;
                                            y: 3px;
                                            width: thumb.width;
                                            height: thumb.height;
                                            background: root.paper;
                                            Image {
                                                width: parent.width;
                                                height: parent.height;
                                                source: thumb.image;
                                                image-fit: fill;
                                            }
                                        }
                                    }
                                    Text {
                                        y: thumb.height + 16px;
                                        width: parent.width;
                                        text: thumb.label;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        color: thumb.current ? Theme.text : Theme.text-muted;
                                    }
                                    thumb-touch := TouchArea {
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.thumb-press(thumb.index, e.modifiers.control, e.modifiers.shift, false);
                                            }
                                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                                                root.thumb-drop(thumb.index, self.mouse-y - self.pressed-y);
                                            }
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                                root.thumb-press(thumb.index, false, false, true);
                                                page-menu.show();
                                            }
                                        }
                                    }
                                    page-menu := PopupWindow {
                                        x: min(thumb-touch.mouse-x, parent.width - 120px);
                                        y: thumb-touch.mouse-y;
                                        width: 200px;
                                        Menu {
                                            MenuEntry { text: "Rotate right"; clicked => { root.command("pages-rotate-cw"); } }
                                            MenuEntry { text: "Rotate left"; clicked => { root.command("pages-rotate-ccw"); } }
                                            MenuEntry { text: "Duplicate"; clicked => { root.command("pages-duplicate"); } }
                                            MenuEntry { text: "Insert blank page after"; clicked => { root.command("pages-insert-blank"); } }
                                            MenuEntry { text: "Insert pages from file\u{2026}"; clicked => { root.command("pages-insert-file"); } }
                                            MenuEntry { text: "Replace from file\u{2026}"; clicked => { root.command("pages-replace"); } }
                                            MenuEntry { text: "Move to\u{2026}"; clicked => { root.command("pages-move"); } }
                                            MenuEntry { text: "Extract\u{2026}"; clicked => { root.command("pages-extract"); } }
                                            MenuEntry { text: "Crop\u{2026}"; clicked => { root.command("pages-crop"); } }
                                            MenuEntry { text: "Delete"; clicked => { root.command("pages-delete"); } }
                                        }
                                    }
                                }
                            }

                            ListView {
                                visible: root.sidebar-tab == 1;
                                for row[i] in root.outline: Rectangle {
                                    height: 30px;
                                    background: row.current ? Theme.bg-active : row-touch.has-hover ? Theme.bg-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: row.title;
                                    accessible-expandable: row.has-children;
                                    accessible-expanded: row.expanded;
                                    accessible-action-default => { root.outline-clicked(i); }
                                    accessible-action-expand => { root.outline-toggle(i); }
                                    row-touch := TouchArea {
                                        clicked => {
                                            root.outline-clicked(i);
                                        }
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                                root.outline-menu(i);
                                                bookmark-menu.show();
                                            }
                                        }
                                    }
                                    bookmark-menu := PopupWindow {
                                        x: min(row-touch.mouse-x, parent.width - 120px);
                                        y: row-touch.mouse-y;
                                        width: 200px;
                                        Menu {
                                            MenuEntry { text: "Add a bookmark after\u{2026}"; clicked => { root.command("bookmark-add"); } }
                                            MenuEntry { text: "Rename\u{2026}"; clicked => { root.command("bookmark-rename"); } }
                                            MenuEntry { text: "Move up"; clicked => { root.command("bookmark-up"); } }
                                            MenuEntry { text: "Move down"; clicked => { root.command("bookmark-down"); } }
                                            MenuEntry { text: "Indent"; clicked => { root.command("bookmark-indent"); } }
                                            MenuEntry { text: "Outdent"; clicked => { root.command("bookmark-outdent"); } }
                                            MenuEntry { text: "Delete"; clicked => { root.command("bookmark-delete"); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px + row.depth * 14px;
                                        padding-right: 8px;
                                        spacing: 2px;
                                        Rectangle {
                                            width: 18px;
                                            Icon {
                                                text: row.has-children ? (row.expanded ? "\u{E70D}" : "\u{E76C}") : "";
                                                font-size: 9px;
                                                color: Theme.text-muted;
                                            }
                                            TouchArea {
                                                enabled: row.has-children;
                                                clicked => {
                                                    root.outline-toggle(i);
                                                }
                                            }
                                        }
                                        Text {
                                            text: row.title;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            color: Theme.text;
                                        }
                                    }
                                }
                            }

                            ListView {
                                visible: root.sidebar-tab == 3;
                                for file[i] in root.attachments: Rectangle {
                                    height: 46px;
                                    background: file-touch.has-hover ? Theme.bg-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: "Save " + file.name;
                                    accessible-action-default => { root.attachment-save(i); }
                                    file-touch := TouchArea {
                                        clicked => {
                                            root.attachment-save(i);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: file.name;
                                                color: Theme.text;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: file.detail;
                                                font-size: 11px;
                                                color: Theme.text-subtle;
                                            }
                                        }
                                        Icon {
                                            width: 20px;
                                            text: "\u{E74E}";
                                            color: Theme.text-muted;
                                        }
                                        Rectangle {
                                            width: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: file-delete-touch.has-hover ? Theme.bg-active : transparent;
                                            accessible-role: button;
                                            accessible-label: "Delete " + file.name;
                                            accessible-action-default => {
                                                root.attachment-delete(i);
                                            }
                                            Icon {
                                                text: "\u{E74D}";
                                                color: Theme.text-muted;
                                            }
                                            file-delete-touch := TouchArea {
                                                clicked => {
                                                    root.attachment-delete(i);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                visible: root.sidebar-tab == 5;
                                VerticalLayout {
                                HorizontalLayout {
                                    spacing: 4px;
                                    LineEdit {
                                        placeholder-text: "Filter comments";
                                        accessible-label: "Filter comments";
                                        text <=> root.comment-filter;
                                        edited(t) => {
                                            root.comment-filter-edited(t);
                                        }
                                    }
                                    ToolButton {
                                        icon: "\u{E8A5}";
                                        tip: "Summarize comments";
                                        clicked => {
                                            root.command("summarize-comments");
                                        }
                                    }
                                }
                                ListView {
                                for comment in root.comments: Rectangle {
                                    height: comment.text != "" ? 56px : 40px;
                                    background: comment-touch.has-hover ? Theme.bg-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: comment.kind + ", " + comment.detail + (comment.status != "" ? ", " + comment.status : "") + (comment.text != "" ? ": " + comment.text : "");
                                    accessible-action-default => { root.comment-clicked(comment.index); }
                                    comment-touch := TouchArea {
                                        clicked => {
                                            root.comment-clicked(comment.index);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: comment.reply ? 30px : 12px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: comment.kind + " \u{00B7} " + comment.detail;
                                                    font-size: 11px;
                                                    color: Theme.text-muted;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                if comment.status != "": Rectangle {
                                                    border-radius: Theme.radius-sm;
                                                    background: Theme.bg-active;
                                                    HorizontalLayout {
                                                        padding-left: 5px;
                                                        padding-right: 5px;
                                                        Text {
                                                            text: comment.status;
                                                            font-size: 10px;
                                                            color: Theme.text;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                            if comment.text != "": Text {
                                                text: comment.text;
                                                color: Theme.text;
                                                overflow: elide;
                                            }
                                        }
                                        if !comment.reply: Rectangle {
                                            width: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: more-touch.has-hover ? Theme.bg-active : transparent;
                                            accessible-role: button;
                                            accessible-label: "Reply or set status";
                                            accessible-action-default => {
                                                more-menu.show();
                                            }
                                            Icon {
                                                text: "\u{E712}";
                                                color: Theme.text-muted;
                                            }
                                            more-touch := TouchArea {
                                                clicked => {
                                                    more-menu.show();
                                                }
                                            }
                                            more-menu := PopupWindow {
                                                x: parent.width - 180px;
                                                y: parent.height;
                                                width: 180px;
                                                Menu {
                                                    MenuEntry { text: "Reply"; clicked => { root.comment-reply(comment.index); } }
                                                    MenuEntry { text: "Accepted"; checked: comment.status == "Accepted"; clicked => { root.comment-status(comment.index, "Accepted"); } }
                                                    MenuEntry { text: "Rejected"; checked: comment.status == "Rejected"; clicked => { root.comment-status(comment.index, "Rejected"); } }
                                                    MenuEntry { text: "Cancelled"; checked: comment.status == "Cancelled"; clicked => { root.comment-status(comment.index, "Cancelled"); } }
                                                    MenuEntry { text: "Completed"; checked: comment.status == "Completed"; clicked => { root.comment-status(comment.index, "Completed"); } }
                                                    if comment.status != "": MenuEntry { text: "Clear status"; clicked => { root.comment-status(comment.index, "None"); } }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: edit-touch.has-hover ? Theme.bg-active : transparent;
                                            accessible-role: button;
                                            accessible-label: "Edit comment text";
                                            accessible-action-default => {
                                                root.comment-edit(comment.index);
                                            }
                                            Icon {
                                                text: "\u{E70F}";
                                                color: Theme.text-muted;
                                            }
                                            edit-touch := TouchArea {
                                                clicked => {
                                                    root.comment-edit(comment.index);
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: delete-touch.has-hover ? Theme.bg-active : transparent;
                                            accessible-role: button;
                                            accessible-label: "Delete comment";
                                            accessible-action-default => {
                                                root.comment-delete(comment.index);
                                            }
                                            Icon {
                                                text: "\u{E74D}";
                                                color: Theme.text-muted;
                                            }
                                            delete-touch := TouchArea {
                                                clicked => {
                                                    root.comment-delete(comment.index);
                                                }
                                            }
                                        }
                                    }
                                }
                                }
                                }
                            }

                            ListView {
                                visible: root.sidebar-tab == 4;
                                for layer[i] in root.layers: Rectangle {
                                    height: 30px;
                                    background: layer-touch.has-hover && layer.toggle && !layer.locked ? Theme.bg-hover : transparent;
                                    accessible-role: checkbox;
                                    accessible-label: layer.name;
                                    accessible-checked: layer.visible;
                                    accessible-checkable: true;
                                    accessible-enabled: layer.toggle && !layer.locked;
                                    accessible-action-default => {
                                        if (layer.toggle && !layer.locked) {
                                            root.layer-toggle(i);
                                        }
                                    }
                                    layer-touch := TouchArea {
                                        enabled: layer.toggle && !layer.locked;
                                        clicked => {
                                            root.layer-toggle(i);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px + layer.depth * 14px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Icon {
                                            width: 18px;
                                            text: !layer.toggle ? "" : layer.visible ? "\u{E890}" : "\u{ED1A}";
                                            color: layer.visible ? Theme.accent : Theme.text-subtle;
                                        }
                                        Text {
                                            text: layer.name;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            color: layer.toggle ? Theme.text : Theme.text-muted;
                                            font-weight: layer.toggle ? 400 : 600;
                                        }
                                    }
                                }
                            }

                            ListView {
                                visible: root.sidebar-tab == 6;
                                for sig[i] in root.signatures: Rectangle {
                                    height: sig-row.preferred-height;
                                    background: sig-touch.has-hover ? Theme.bg-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: sig.name + ": " + sig.status;
                                    accessible-action-default => {
                                        root.signature-go(i);
                                    }
                                    sig-touch := TouchArea {
                                        clicked => {
                                            root.signature-go(i);
                                        }
                                    }
                                    sig-row := HorizontalLayout {
                                        padding: 8px;
                                        padding-left: 12px;
                                        spacing: 8px;
                                        Icon {
                                            width: 20px;
                                            height: 18px;
                                            text: sig.state == 0 ? "\u{E70F}" : sig.state == 1 ? "\u{E73E}" : sig.state == 2 ? "\u{E7BA}" : "\u{E711}";
                                            color: sig.state == 1 ? Theme.accent : sig.state == 3 ? Theme.danger : Theme.text-muted;
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: sig.name;
                                                color: Theme.text;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: sig.status;
                                                wrap: word-wrap;
                                                font-size: 11px;
                                                color: sig.state == 3 ? Theme.danger : Theme.text-muted;
                                            }
                                            if sig.detail != "": Text {
                                                text: sig.detail;
                                                wrap: word-wrap;
                                                font-size: 11px;
                                                color: Theme.text-subtle;
                                            }
                                        }
                                    }
                                }
                            }

                            ListView {
                                visible: root.sidebar-tab == 2;
                                for row in root.info: VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 2px;
                                    Text {
                                        text: row.label;
                                        font-size: 11px;
                                        color: Theme.text-subtle;
                                    }
                                    Text {
                                        text: row.value;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.border-muted;
                    }
                }

                // Document view
                Rectangle {
                    horizontal-stretch: 1;
                    background: root.presenting ? #000000 : Theme.bg;
                    clip: true;

                    scroller := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        content-width: max(self.visible-width, root.document-width);
                        content-height: max(self.visible-height, root.document-height);

                        for page in root.pages: Rectangle {
                            x: page.x;
                            y: page.y;
                            width: page.width;
                            height: page.height;
                            background: root.paper;
                            drop-shadow-blur: root.presenting ? 0px : Theme.sheet-shadow-blur;
                            drop-shadow-offset-y: Theme.sheet-shadow-offset;
                            drop-shadow-color: Theme.shadow-sheet;
                            accessible-role: image;
                            accessible-label: "Page " + (page.index + 1);
                        }
                        for tile in root.tiles: Image {
                            x: tile.x;
                            y: tile.y;
                            width: tile.width;
                            height: tile.height;
                            source: tile.image;
                            image-fit: fill;
                        }
                        for mark in root.marks: Rectangle {
                            x: mark.x;
                            y: mark.y;
                            width: mark.width;
                            height: mark.height;
                            border-radius: 2px;
                            background: mark.kind == 0 ? #ffd54a59
                                : mark.kind == 1 ? #ff9a1f99
                                : mark.kind == 2 ? #4a7dff4d
                                : mark.kind == 4 ? #ffffff
                                : mark.kind == 5 ? transparent
                                : mark.kind == 6 ? Theme.accent-glow
                                : mark.kind >= 7 ? #e5484d47
                                : #8d9cff40;
                            border-width: mark.kind == 4 ? 1px : mark.kind == 5 || mark.kind == 6 || mark.kind == 8 ? 2px : 0px;
                            border-color: Theme.accent;
                        }
                        Rectangle {
                            visible: root.ghost-visible;
                            x: root.ghost-x;
                            y: root.ghost-y;
                            width: root.ghost-width;
                            height: root.ghost-height;
                            border-width: 1px;
                            border-color: Theme.accent;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.ghost-image;
                                image-fit: fill;
                                opacity: 0.6;
                            }
                        }
                        text-menu := PopupWindow {
                            x: root.menu-x;
                            y: root.menu-y;
                            width: 220px;
                            Menu {
                                MenuEntry {
                                    text: "Copy";
                                    clicked => {
                                        root.command("copy");
                                    }
                                }
                                MenuEntry {
                                    text: "Highlight";
                                    clicked => {
                                        root.command("highlight");
                                    }
                                }
                                MenuEntry {
                                    text: "Explain with the assistant";
                                    clicked => {
                                        root.command("ask-selection");
                                    }
                                }
                            }
                        }
                        field-menu := PopupWindow {
                            x: root.field-x;
                            y: root.field-y + root.field-height + 2px;
                            width: max(root.field-width, 160px);
                            height: min(root.field-options.length * 30px + 10px, 310px);
                            Menu {
                                ListView {
                                    for option[i] in root.field-options: MenuEntry {
                                        text: option;
                                        checked: option == root.field-text;
                                        clicked => {
                                            root.field-choose(i);
                                        }
                                    }
                                }
                            }
                        }
                        if root.draft-path != "": Path {
                            x: 0;
                            y: 0;
                            width: max(scroller.visible-width, root.document-width);
                            height: max(scroller.visible-height, root.document-height);
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: root.draft-path;
                            stroke: Theme.accent;
                            stroke-width: 1.5px;
                        }
                        TouchArea {
                            width: max(scroller.visible-width, root.document-width);
                            height: max(scroller.visible-height, root.document-height);
                            mouse-cursor: root.tool != 0 ? MouseCursor.crosshair : root.cursor == 1 ? MouseCursor.text : root.cursor == 2 ? MouseCursor.pointer : root.cursor == 3 ? MouseCursor.move : root.cursor == 4 ? MouseCursor.nwse-resize : root.cursor == 5 ? MouseCursor.nesw-resize : MouseCursor.default;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.focus-view();
                                    root.pointer-down(
                                        self.mouse-x,
                                        self.mouse-y,
                                        e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 1 : 2,
                                        e.modifiers.shift);
                                } else if (e.kind == PointerEventKind.up) {
                                    root.pointer-up(self.mouse-x, self.mouse-y);
                                }
                            }
                            moved => {
                                root.pointer-move(self.mouse-x, self.mouse-y);
                            }
                            double-clicked => {
                                root.pointer-double(self.mouse-x, self.mouse-y);
                            }
                            changed mouse-x => {
                                if (!self.pressed) {
                                    root.hover(self.mouse-x, self.mouse-y);
                                }
                            }
                            changed mouse-y => {
                                if (!self.pressed) {
                                    root.hover(self.mouse-x, self.mouse-y);
                                }
                            }
                            changed has-hover => {
                                if (!self.has-hover) {
                                    root.pointer-left();
                                }
                            }
                            scroll-event(e) => {
                                if (e.modifiers.control) {
                                    root.wheel-zoom(e.delta-y, self.mouse-x, self.mouse-y);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        Rectangle {
                            visible: root.field-editing;
                            x: root.field-x;
                            y: root.field-y;
                            width: root.field-width;
                            height: root.field-height;
                            background: #ffffff;
                            border-width: 2px;
                            border-color: Theme.accent;
                            clip: true;
                            FocusScope {
                                capture-key-pressed(e) => {
                                    if (e.text == Key.Escape) {
                                        root.field-cancel();
                                        return accept;
                                    }
                                    if (e.text == Key.Tab || e.text == Key.Backtab) {
                                        root.field-commit(e.text == Key.Backtab || e.modifiers.shift ? -1 : 1);
                                        return accept;
                                    }
                                    if (e.text == Key.Return && (!root.field-multiline || e.modifiers.control)) {
                                        root.field-commit(0);
                                        return accept;
                                    }
                                    return reject;
                                }
                                field-input := TextInput {
                                    x: 4px;
                                    y: root.field-multiline ? 3px : 0px;
                                    width: parent.width - 8px;
                                    height: root.field-multiline ? parent.height - 6px : parent.height;
                                    text <=> root.field-text;
                                    font-size: root.field-font-size;
                                    color: #000000;
                                    selection-background-color: #4a7dff66;
                                    single-line: !root.field-multiline;
                                    wrap: root.field-multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
                                    vertical-alignment: root.field-multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
                                    accessible-label: root.field-name;
                                    changed has-focus => {
                                        if (!self.has-focus && root.field-editing) {
                                            root.field-commit(2);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Empty state
                    if !root.has-document: VerticalLayout {
                        alignment: center;
                        spacing: 14px;
                        padding: 24px;
                        Text {
                            text: "micropdf";
                            font-family: Theme.font-display;
                            font-size: 28px;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a PDF with Ctrl+O, or drop one onto this window.";
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            DialogButton {
                                text: "Open a PDF";
                                primary: true;
                                clicked => {
                                    root.command("open");
                                }
                            }
                            DialogButton {
                                text: root.has-library ? "Search the library" : "Add a library folder";
                                clicked => {
                                    root.command(root.has-library ? "library-search" : "library-add");
                                }
                            }
                        }
                        if root.recent-items.length > 0: Text {
                            text: "Recent";
                            font-size: 11px;
                            color: Theme.text-subtle;
                            horizontal-alignment: center;
                        }
                        for item[i] in root.recent-items: HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: min(520px, root.width - 80px);
                                height: 42px;
                                border-radius: Theme.radius;
                                background: recent-touch.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: "Open " + item.title;
                                accessible-action-default => { root.recent-clicked(i); }
                                recent-touch := TouchArea {
                                    clicked => {
                                        root.recent-clicked(i);
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: item.title;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: item.detail;
                                        font-size: 11px;
                                        color: Theme.text-subtle;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // Style bar
                    if root.style-visible: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 16px;
                        width: style-row.preferred-width;
                        height: 44px;
                        background: Theme.bg-tertiary;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: Theme.shadow-lg;
                        TouchArea { }
                        style-row := HorizontalLayout {
                            padding: 7px;
                            spacing: 4px;
                            for swatch[i] in root.swatches: Rectangle {
                                width: 30px;
                                border-radius: Theme.radius-sm;
                                background: swatch-touch.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: swatch.name;
                                accessible-action-default => {
                                    root.style-color-picked(i);
                                }
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: swatch.color;
                                    border-width: root.style-color == i ? 2px : 1px;
                                    border-color: root.style-color == i ? Theme.text : Theme.border;
                                }
                                swatch-touch := TouchArea {
                                    clicked => {
                                        root.style-color-picked(i);
                                    }
                                }
                            }
                            if root.style-fill >= 0: ToolButton {
                                label: "Fill";
                                tip: root.style-fill == 1 ? "Remove the fill" : "Fill with the line colour";
                                active: root.style-fill == 1;
                                clicked => {
                                    root.style-fill-toggled();
                                }
                            }
                            if root.style-width > 0: ToolButton {
                                label: root.style-width + " pt";
                                tip: "Line width";
                                clicked => {
                                    width-menu.show();
                                }
                            }
                            if root.style-opacity >= 0: ToolButton {
                                label: root.style-opacity + "%";
                                tip: "Opacity";
                                clicked => {
                                    opacity-menu.show();
                                }
                            }
                            if root.style-border >= 0: ToolButton {
                                label: root.style-border == 1 ? "Dashed" : root.style-border == 2 ? "Cloudy" : "Solid";
                                tip: "Border";
                                clicked => {
                                    border-menu.show();
                                }
                            }
                            if root.style-start != "": ToolButton {
                                label: "Start";
                                tip: "Line start";
                                clicked => {
                                    root.ends-start = true;
                                    ends-menu.show();
                                }
                            }
                            if root.style-end != "": ToolButton {
                                label: "End";
                                tip: "Line end";
                                clicked => {
                                    root.ends-start = false;
                                    ends-menu.show();
                                }
                            }
                            if root.style-font-size > 0: ToolButton {
                                label: "Aa " + root.style-font-size;
                                tip: "Text size";
                                clicked => {
                                    size-menu.show();
                                }
                            }
                            if root.style-picked: ToolButton {
                                icon: "\u{E946}";
                                tip: "Properties";
                                clicked => {
                                    root.style-properties();
                                }
                            }
                        }
                        border-menu := PopupWindow {
                            x: parent.width - 120px;
                            y: root.style-cloudy ? -102px : -72px;
                            width: 120px;
                            Menu {
                                MenuEntry {
                                    text: "Solid";
                                    checked: root.style-border == 0;
                                    clicked => {
                                        root.style-border-picked(0);
                                    }
                                }
                                MenuEntry {
                                    text: "Dashed";
                                    checked: root.style-border == 1;
                                    clicked => {
                                        root.style-border-picked(1);
                                    }
                                }
                                if root.style-cloudy: MenuEntry {
                                    text: "Cloudy";
                                    checked: root.style-border == 2;
                                    clicked => {
                                        root.style-border-picked(2);
                                    }
                                }
                            }
                        }
                        ends-menu := PopupWindow {
                            x: parent.width - 150px;
                            y: -(root.line-ends.length * 30px + 12px);
                            width: 150px;
                            Menu {
                                for e in root.line-ends: MenuEntry {
                                    text: e.label;
                                    checked: (root.ends-start ? root.style-start : root.style-end) == e.name;
                                    clicked => {
                                        root.style-end-picked(root.ends-start, e.name);
                                    }
                                }
                            }
                        }
                        size-menu := PopupWindow {
                            x: parent.width - 120px;
                            y: -222px;
                            width: 120px;
                            Menu {
                                for s in [8, 10, 12, 14, 18, 24, 36]: MenuEntry {
                                    text: s + " pt";
                                    checked: abs(root.style-font-size - s) < 0.1;
                                    clicked => {
                                        root.style-font-size-picked(s);
                                    }
                                }
                            }
                        }
                        width-menu := PopupWindow {
                            x: parent.width - 120px;
                            y: -140px;
                            width: 120px;
                            Menu {
                                for w in [1, 2, 3, 5]: MenuEntry {
                                    text: w + " pt";
                                    checked: abs(root.style-width - w) < 0.1;
                                    clicked => {
                                        root.style-width-picked(w);
                                    }
                                }
                            }
                        }
                        opacity-menu := PopupWindow {
                            x: parent.width - 120px;
                            y: -140px;
                            width: 120px;
                            Menu {
                                for o in [100, 75, 50, 25]: MenuEntry {
                                    text: o + "%";
                                    checked: root.style-opacity == o;
                                    clicked => {
                                        root.style-opacity-picked(o);
                                    }
                                }
                            }
                        }
                    }

                    // Find bar
                    Rectangle {
                        visible: root.find-visible;
                        x: parent.width - self.width - 24px;
                        y: 10px;
                        width: min(440px, parent.width - 48px);
                        height: 46px;
                        background: Theme.bg-tertiary;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: Theme.shadow-lg;
                        TouchArea { }
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 4px;
                            find-edit := LineEdit {
                                placeholder-text: "Find in document";
                                text <=> root.find-query;
                                accessible-label: "Find";
                                edited(t) => {
                                    root.find-edited(t);
                                }
                                accepted => {
                                    root.find-next();
                                }
                            }
                            Text {
                                text: root.find-status;
                                color: Theme.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                min-width: 70px;
                                horizontal-alignment: center;
                            }
                            ToolButton {
                                icon: "\u{E70E}";
                                tip: "Previous match (Shift+Enter)";
                                clicked => {
                                    root.find-prev();
                                }
                            }
                            ToolButton {
                                icon: "\u{E70D}";
                                tip: "Next match (Enter)";
                                clicked => {
                                    root.find-next();
                                }
                            }
                            ToolButton {
                                icon: "\u{E711}";
                                tip: "Close (Esc)";
                                clicked => {
                                    root.command("find-close");
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: root.split-open && !root.presenting ? 1px : 0px;
                    background: Theme.border-muted;
                }

                split-pane := SplitPane {
                    horizontal-stretch: 1;
                    max-width: root.split-open && !root.presenting ? 100000px : 0px;
                    visible: root.split-open && !root.presenting;
                    clip: true;
                    title: root.split-title;
                    synced: root.split-synced;
                    comparing: root.split-comparing;
                    overlay: root.split-overlay;
                    pages: root.split-pages;
                    marks: root.split-marks;
                    content-height: root.split-content-height;
                    command(id) => { root.command(id); }
                    scrolled => { root.split-scrolled(); }
                }

                assistant-panel := AssistantPanel {
                    width: Assistant.open && root.chrome-visible ? Theme.assistant-width : 0px;
                    visible: self.width > 0;
                }
            }

            // ---- Status bar ----
            Rectangle {
                height: root.chrome-visible ? Theme.statusbar-height : 0px;
                visible: self.height > 0;
                background: Theme.bg-secondary;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.status-left;
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.status-right;
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border-muted;
                }
            }
        }

        // ---- Command palette ----
        Rectangle {
            visible: root.palette-visible;
            background: #00000059;
            TouchArea {
                clicked => {
                    root.command("palette-close");
                }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 56px;
                width: min(600px, parent.width - 40px);
                height: min(440px, parent.height - 100px);
                background: Theme.bg-tertiary;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 30px;
                drop-shadow-color: Theme.shadow-lg;
                TouchArea { }
                FocusScope {
                    capture-key-pressed(e) => {
                        if (e.text == Key.UpArrow) {
                            root.palette-selected = max(0, root.palette-selected - 1);
                            return accept;
                        }
                        if (e.text == Key.DownArrow) {
                            root.palette-selected = min(root.palette-items.length - 1, root.palette-selected + 1);
                            return accept;
                        }
                        if (e.text == Key.Escape) {
                            root.command("palette-close");
                            return accept;
                        }
                        return reject;
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        palette-edit := LineEdit {
                            placeholder-text: root.palette-hint;
                            accessible-label: "Command";
                            edited(t) => {
                                root.palette-edited(t);
                            }
                            accepted => {
                                root.palette-accept(root.palette-selected);
                            }
                        }
                        ListView {
                            for item[i] in root.palette-items: Rectangle {
                                height: 36px;
                                border-radius: Theme.radius-sm;
                                background: i == root.palette-selected ? Theme.bg-active : item-touch.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: item.title;
                                accessible-action-default => { root.palette-accept(i); }
                                item-touch := TouchArea {
                                    clicked => {
                                        root.palette-accept(i);
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text {
                                        text: item.title;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: item.detail;
                                        color: Theme.text-subtle;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        max-width: 220px;
                                    }
                                    Text {
                                        text: item.shortcut;
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Signature pad ----
        Rectangle {
            visible: root.sign-kind != "";
            background: #00000066;
            TouchArea { }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 3;
                width: min(480px, parent.width - 40px);
                height: sign-layout.preferred-height;
                background: Theme.bg-tertiary;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 30px;
                drop-shadow-color: Theme.shadow-lg;
                accessible-role: groupbox;
                accessible-label: sign-title.text;
                sign-focus := FocusScope {
                    capture-key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.command("sign-cancel");
                            return accept;
                        }
                        return reject;
                    }
                    sign-layout := VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        sign-title := Text {
                            text: root.sign-kind == "initials" ? "Create initials" : "Create signature";
                            font-family: Theme.font-display;
                            font-size: 16px;
                            color: Theme.text;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            SidebarTab {
                                width: 64px;
                                text: "Type";
                                active: root.sign-mode == 0;
                                clicked => { root.sign-mode = 0; }
                            }
                            SidebarTab {
                                width: 64px;
                                text: "Draw";
                                active: root.sign-mode == 1;
                                clicked => { root.sign-mode = 1; }
                            }
                            SidebarTab {
                                width: 64px;
                                text: "Image";
                                active: root.sign-mode == 2;
                                clicked => { root.sign-mode = 2; }
                            }
                        }
                        Rectangle {
                            height: 150px;
                            background: #ffffff;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            if root.sign-mode == 0: Text {
                                text: root.sign-text;
                                font-family: root.sign-fonts[root.sign-font];
                                font-size: root.sign-kind == "initials" ? 56px : 40px;
                                color: #1a1a1a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.sign-mode == 1 && root.sign-path != "": Path {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: self.width / 1px;
                                viewbox-height: self.height / 1px;
                                commands: root.sign-path;
                                stroke: #1a1a1a;
                                stroke-width: 3px;
                            }
                            if root.sign-mode == 1: TouchArea {
                                mouse-cursor: MouseCursor.crosshair;
                                accessible-role: image;
                                accessible-label: "Drawing pad";
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        root.sign-pad-down(self.mouse-x, self.mouse-y);
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.sign-pad-move(self.mouse-x, self.mouse-y);
                                    }
                                }
                            }
                            if root.sign-mode == 1 && root.sign-path == "": Text {
                                text: "Draw here";
                                color: #8a8a8a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.sign-mode == 2: Image {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                height: parent.height - 24px;
                                source: root.sign-image;
                                image-fit: contain;
                            }
                            if root.sign-mode == 2 && root.sign-image.width == 0: Text {
                                text: "No image chosen";
                                color: #8a8a8a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if root.sign-mode == 0: LineEdit {
                            height: 34px;
                            text <=> root.sign-text;
                            placeholder-text: root.sign-kind == "initials" ? "Your initials" : "Your name";
                            accessible-label: root.sign-kind == "initials" ? "Initials" : "Name";
                        }
                        if root.sign-mode == 0: HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            for font[i] in root.sign-fonts: Rectangle {
                                width: 104px;
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: root.sign-font == i ? Theme.bg-active : font-touch.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: font;
                                accessible-action-default => { root.sign-font = i; }
                                Text {
                                    text: root.sign-text == "" ? "Signature" : root.sign-text;
                                    font-family: font;
                                    font-size: 15px;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                font-touch := TouchArea {
                                    clicked => { root.sign-font = i; }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            if root.sign-mode == 1: DialogButton {
                                text: "Clear";
                                clicked => { root.command("sign-clear"); }
                            }
                            if root.sign-mode == 2: DialogButton {
                                text: "Choose image";
                                clicked => { root.command("sign-image"); }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            DialogButton {
                                text: "Cancel";
                                clicked => { root.command("sign-cancel"); }
                            }
                            DialogButton {
                                text: "Done";
                                primary: true;
                                clicked => { root.command("sign-done"); }
                            }
                        }
                    }
                }
            }
        }

        // ---- Dialog ----
        Rectangle {
            visible: root.dialog-kind != "";
            background: #00000066;
            TouchArea { }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 3;
                width: min(root.dialog-kind == "form" ? 480px : 440px, parent.width - 40px);
                height: dialog-layout.preferred-height;
                background: Theme.bg-tertiary;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 30px;
                drop-shadow-color: Theme.shadow-lg;
                accessible-role: groupbox;
                accessible-label: root.dialog-title;
                FocusScope {
                    capture-key-pressed(e) => {
                        if (e.text == Key.Escape && root.dialog-cancel-text != "") {
                            root.dialog-cancel();
                            return accept;
                        }
                        if (e.text == Key.Return && root.dialog-kind != "password" && root.dialog-kind != "input") {
                            root.dialog-accept(root.dialog-input);
                            return accept;
                        }
                        return reject;
                    }
                    dialog-layout := VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: root.dialog-title;
                            font-family: Theme.font-display;
                            font-size: 16px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.dialog-text;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            visible: root.dialog-kind == "properties";
                            height: self.visible ? props-layout.preferred-height : 0px;
                            props-layout := VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Author";
                                    color: Theme.text-muted;
                                }
                                dialog-author-edit := LineEdit {
                                    text <=> root.dialog-author;
                                    accessible-label: "Author";
                                }
                                Text {
                                    text: "Subject";
                                    color: Theme.text-muted;
                                }
                                LineEdit {
                                    text <=> root.dialog-subject;
                                    accessible-label: "Subject";
                                }
                                CheckBox {
                                    text: "Locked: it cannot be moved, resized, restyled or deleted";
                                    checked <=> root.dialog-locked;
                                }
                                CheckBox {
                                    text: "Printed with the page";
                                    checked <=> root.dialog-printed;
                                }
                            }
                        }
                        if root.dialog-kind == "form": VerticalLayout {
                            spacing: 6px;
                            for field[i] in root.form-fields: HorizontalLayout {
                                spacing: 10px;
                                if field.kind != 2: Text {
                                    width: 130px;
                                    text: field.label;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                if field.kind == 0 || field.kind == 1: LineEdit {
                                    horizontal-stretch: 1;
                                    text: field.text;
                                    input-type: field.kind == 1 ? InputType.password : InputType.text;
                                    accessible-label: field.label;
                                    edited(t) => {
                                        root.form-edited(i, t);
                                    }
                                }
                                if field.kind == 2: CheckBox {
                                    text: field.label;
                                    checked: field.checked;
                                    toggled => {
                                        root.form-checked(i, self.checked);
                                    }
                                }
                                if field.kind == 3: ComboBox {
                                    horizontal-stretch: 1;
                                    model: field.options;
                                    current-index: field.index;
                                    accessible-label: field.label;
                                    selected => {
                                        root.form-chosen(i, self.current-index);
                                    }
                                }
                            }
                        }
                        dialog-edit := LineEdit {
                            visible: root.dialog-kind == "password" || root.dialog-kind == "input";
                            height: self.visible ? 34px : 0px;
                            input-type: root.dialog-kind == "password" ? InputType.password : InputType.text;
                            text <=> root.dialog-input;
                            accessible-label: root.dialog-kind == "password" ? "Password" : root.dialog-title;
                            accepted(t) => {
                                root.dialog-accept(t);
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            if root.dialog-cancel-text != "": DialogButton {
                                text: root.dialog-cancel-text;
                                clicked => {
                                    root.dialog-cancel();
                                }
                            }
                            DialogButton {
                                text: root.dialog-ok;
                                primary: true;
                                clicked => {
                                    root.dialog-accept(root.dialog-input);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
